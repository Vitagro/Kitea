# PostgreSQL (extension PostGIS activée sur la base cible)
# En local : une seule URL suffit (DATABASE_URL = DIRECT_URL).
# Avec Supabase : DATABASE_URL = connexion "pooled" (port 6543, pgbouncer),
# DIRECT_URL = connexion directe (port 5432), requise par `prisma migrate`.
DATABASE_URL="postgresql://kitea:kitea@localhost:5432/kitea_logistics?schema=public"
DIRECT_URL="postgresql://kitea:kitea@localhost:5432/kitea_logistics?schema=public"

# API
PORT=4000
NODE_ENV=development
# Liste séparée par des virgules — inclut le frontend Next.js (défaut :3000)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production

# ERP Integration Layer
ERP_WEBHOOK_SECRET=change-me-in-production
ERP_BASE_URL=https://erp.kitea.internal/api

# Géocodage Google Maps (optionnel — active POST /api/locations/:id/geocode)
# Google Cloud Console > APIs & Services > activer "Geocoding API" > Credentials > créer une clé API,
# puis restreindre la clé à l'API Geocoding + à l'IP/domaine du serveur (Render).
GOOGLE_MAPS_API_KEY=
